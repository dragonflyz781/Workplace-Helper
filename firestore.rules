rules_version = '2';

// ============================================================================
// Round Tracker (multi-company) - Firestore security rules
//
// Data layout
//   users/{uid}                          { companyId, role: 'admin'|'driver', name, email, createdAt }
//   companies/{companyId}                { name, ownerUid, createdAt, operator?: { name, address?, tel?, email? } }
//   companies/{companyId}/routes/{id}    route documents (track, stops, timetable ...)
//   companies/{companyId}/runs/{id}      submitted driver runs (passenger counts per stop) - write-once
//
// Principles
//   * Everything requires a signed-in user who has a users/{uid} profile.
//   * A user can only ever touch data under their OWN companyId (taken from their
//     profile document on the server - the browser cannot fake it).
//   * Admins can write routes and manage the users of their own company.
//   * Drivers can read routes. While a run is in progress the passenger counts are kept on the
//     device; when the driver taps "Finish & submit run" ONE run document is created (create only,
//     with driverUid == their own uid). Runs can never be updated; only admins can read all runs
//     of their company (a driver can read only their own) and only admins can delete them.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasProfile() { return signedIn() && exists(profilePath(request.auth.uid)); }
    function myProfile() { return get(profilePath(request.auth.uid)).data; }
    function inCompany(cid) { return hasProfile() && myProfile().companyId == cid; }
    function isAdmin(cid)   { return inCompany(cid) && myProfile().role == 'admin'; }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      // You can read your own profile; admins can read the profiles of their company.
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin(resource.data.companyId));

      // (a) Company registration: a brand-new user creates THEIR OWN admin profile, and only
      //     for a company document that is created in the same batch with them as owner.
      allow create: if signedIn() && uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['companyId','role','name','email','createdAt'])
                    && request.resource.data.role == 'admin'
                    && request.resource.data.companyId is string
                    && !exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
                    && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerUid == uid;

      // (b) An admin adds a DRIVER to their own company (never an admin, never another company).
      allow create: if signedIn() && uid != request.auth.uid
                    && request.resource.data.keys().hasOnly(['companyId','role','name','email','createdAt'])
                    && request.resource.data.role == 'driver'
                    && request.resource.data.companyId is string
                    && isAdmin(request.resource.data.companyId);

      // Admins may rename a user of their company; company and role can never change.
      allow update: if isAdmin(resource.data.companyId)
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.role == resource.data.role;

      // Admins can remove other users (not themselves) of their own company.
      allow delete: if isAdmin(resource.data.companyId) && uid != request.auth.uid;
    }

    // ------------------------------------------------------------ companies
    match /companies/{companyId} {
      allow read: if inCompany(companyId);

      // Creating a company: you become its owner, and you must not already belong to one.
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['name','ownerUid','createdAt'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
                    && !exists(profilePath(request.auth.uid));

      // Operator details shown on every route's Schedule: { name (required), address?, tel?, email? }.
      // Size limits + shape are checked here; email must look like x@y.z (or be empty); tel is free text.
      function validOperator(o) {
        return o is map
            && o.keys().hasOnly(['name','address','tel','email'])
            && o.keys().hasAll(['name'])
            && o.name is string && o.name.trim().size() > 0 && o.name.size() <= 120
            && (!('address' in o) || (o.address is string && o.address.size() <= 250))
            && (!('tel' in o)     || (o.tel is string && o.tel.size() <= 40))
            && (!('email' in o)   || (o.email is string && o.email.size() <= 120
                                      && (o.email.size() == 0 || o.email.matches('^[^@ \\t\\r\\n]+@[^@ \\t\\r\\n]+\\.[^@ \\t\\r\\n]+$'))));
      }

      // Admins may rename the company and set its operator details; nothing else can change
      // (owner can't be changed, no extra fields can be added). Drivers cannot update at all.
      allow update: if isAdmin(companyId)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','operator'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
                    && (!('operator' in request.resource.data) || validOperator(request.resource.data.operator));
      allow delete: if false;

      // --------------------------------------------------------------- routes
      match /routes/{routeId} {
        allow read:  if inCompany(companyId);                // admins and drivers
        allow write: if isAdmin(companyId);                  // create / update / delete: admins only
      }

      // ----------------------------------------------------------------- runs
      // A run is a finished trip with passenger counts, written once by the driver (or an admin
      // driving). Rules cannot loop over the `stops` array, so its elements are not validated
      // one by one - the array length is capped and Firestore's own 1 MiB document limit applies.
      match /runs/{runId} {
        function isCount(v) { return v is int && v >= 0 && v <= 100000; }
        function validRun(d) {
          return d.keys().hasOnly(['routeId','routeName','session','driverUid','driverName','startedAt','submittedAt',
                                   'totalBoarded','totalAlighted','unscheduledBoarded','unscheduledAlighted','stops'])
              && d.keys().hasAll(['routeId','routeName','session','driverUid','driverName','startedAt','submittedAt',
                                  'totalBoarded','totalAlighted','unscheduledBoarded','unscheduledAlighted','stops'])
              && d.routeId is string && d.routeId.size() > 0 && d.routeId.size() <= 128
              && d.routeName is string && d.routeName.size() <= 200
              && d.session is string && d.session.size() <= 10
              && d.driverUid == request.auth.uid
              && d.driverName is string && d.driverName.size() <= 120
              && d.startedAt is timestamp
              && d.submittedAt == request.time
              && isCount(d.totalBoarded) && isCount(d.totalAlighted)
              && isCount(d.unscheduledBoarded) && isCount(d.unscheduledAlighted)
              && d.stops is list && d.stops.size() <= 500;
        }
        // drivers and admins of THIS company, only for themselves
        allow create: if inCompany(companyId) && validRun(request.resource.data);
        // admins read every run of their company; a driver only their own (queries must filter on driverUid)
        allow read:   if isAdmin(companyId) || (inCompany(companyId) && resource.data.driverUid == request.auth.uid);
        allow update: if false;                              // runs are write-once
        allow delete: if isAdmin(companyId);
      }
    }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
